all")params.occurrence="all";else if(typeof occ=="number"&&Number.isInteger(occ)&&occ>=1)params.occurrence=occ;else return{error:`op "${op}": occurrence must be a 1-based whole number or the string "all", got ${JSON.stringify(occ)}.`}}return params}function normalizeToken(text){return text.normalize("NFC").toLowerCase().replace(/[^\p{L}\p{M}\p{N}']/gu,"")}var PER_CHARACTER_SCRIPT=/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u;function splitPerCharacterScripts(token){if(!PER_CHARACTER_SCRIPT.test(token))return[token];let out=[],run2="";for(let char of token)PER_CHARACTER_SCRIPT.test(char)?(run2&&out.push(run2),run2="",out.push(char)):run2+=char;return run2&&out.push(run2),out}var HAS_WORD_CHARACTER=/[\p{L}\p{N}]/u;function isMatchableWord(text){return!!text&&!text.startsWith("__")&&HAS_WORD_CHARACTER.test(normalizeToken(text))}function tokenize(phrase){return phrase.trim().split(/\s+/).map(normalizeToken).flatMap(splitPerCharacterScripts).filter(t=>HAS_WORD_CHARACTER.test(t))}function entryTokens(text){return tokenize(text)}function findPhraseMatches(words,tokens){let flat=[];words.forEach((w,entry)=>{let parts=entryTokens(w.text);parts.forEach((token,k)=>flat.push({token,entry,first:k===0,last:k===parts.length-1}))});let matches=[],i=0;for(;i<=flat.length-tokens.length;)if(flat[i].first&&flat[i+tokens.length-1].last&&tokens.every((t,k)=>flat[i+k].token===t)){let startEntry=flat[i].entry,endEntry=flat[i+tokens.length-1].entry;matches.push({startMs:words[startEntry].timeRange.timelineIn,endMs:words[endEntry].timeRange.timelineOut,startIndex:startEntry,wordCount:endEntry-startEntry+1}),i+=tokens.length}else i+=1;return matches}function secs4(ms){return Math.round(ms/100)/10}function assertSpansLeaveViableClip(ranges,spans,op,phrase){let sorted=[...spans].sort((a,b)=>a.startMs-b.startMs),remainingMs=0,worstSliverMs=null;for(let section of ranges){let cursor=section.startMs,pieces=[];for(let span of sorted){let from=Math.max(span.startMs,section.startMs),to=Math.min(span.endMs,section.endMs);to<=from||(from>cursor&&pieces.push(from-cursor),cursor=Math.max(cursor,to))}cursor<section.endMs&&pieces.push(section.endMs-cursor);for(let piece of pieces)remainingMs+=piece,piece<MIN_SECTION_MS&&(worstSliverMs===null||piece<worstSliverMs)&&(worstSliverMs=piece)}return remainingMs===0?{error:`op "${op}": deleting "${phrase}" would remove everything and leave an empty clip -- no cut was made. Delete the clip instead, or pick a narrower phrase.`}:worstSliverMs!==null?{error:`op "${op}": deleting "${phrase}" would leave a ${secs4(worstSliverMs)}s sliver of a section; a section must keep at least ${secs4(MIN_SECTION_MS)}s -- no cut was made. Use trim_section to cut to the section edge instead.`}:null}function splitReplacementWords(replacement){return replacement.trim().split(/\s+/).flatMap(splitPerCharacterScripts).filter(w=>w.length>0)}function assignReplacement(entries,newWords){let counts=entries.map(entry=>entryTokens(entry.text).length);if(counts.reduce((sum,count)=>sum+count,0)!==newWords.length)return null;let cursor=0;return counts.map(count=>{let part=joinReplacementTokens(newWords.slice(cursor,cursor+count));return cursor+=count,part})}function joinReplacementTokens(tokens){return tokens.reduce((text,token)=>{let last=[...text].slice(-1)[0]??"",needsSpace=last!==""&&!PER_CHARACTER_SCRIPT.test(last)&&!PER_CHARACTER_SCRIPT.test(token);return text+(needsSpace?" ":"")+token},"")}function replaceSelected(replacement,phrase,phraseWordCount,selected,words){let newWords=splitReplacementWords(replacement),assignments=selected.map(match=>assignReplacement(words.slice(match.startIndex,match.startIndex+match.wordCount),newWords));if(assignments.includes(null))return{error:`op "replace_phrase": "${phrase}" is ${phraseWordCount} word(s) but "${replacement}" is ${newWords.length} -- each spoken word keeps its own timing, so the replacement must have the same number of words. Nothing was changed.`};let changed=!1;selected.forEach((match,m)=>{for(let[k,text]of assignments[m].entries()){let word=words[match.startIndex+k];word.text!==text&&(word.changeText(text),word.type=void 0,changed=!0)}});let occurrenceLabel=selected.length>1?`all ${selected.length} occurrences`:"1 occurrence";return{op:"replace_phrase",outcome:changed?`replaced ${occurrenceLabel} of "${phrase}" with "${replacement}"`:`captions already say "${replacement}" -- nothing changed`,changed}}function runPhraseOp(op,params,tracks){let phrase=params.phrase,tokens=tokenize(phrase);if(tokens.length===0)return{error:`op "${op}" needs phrase to contain at least one word.`};let words=Array.from(tracks.cap.textMap.values()).filter(w=>!w.deleted&&isMatchableWord(w.text)).sort((a,b)=>a.timeRange.timelineIn-b.timeRange.timelineIn),matches=findPhraseMatches(words,tokens),nothing=op==="delete_phrase"?"no cut was made":"nothing was changed";if(matches.length===0)return{error:`op "${op}": phrase "${phrase}" was not found in this clip's transcript -- ${nothing}. Check describe_clip for this clip's own transcript text.`};let occurrence=params.occurrence;if(occurrence===void 0&&matches.length>1){let list=matches.map((m,idx)=>`#${idx+1} at ${secs4(m.startMs)}s-${secs4(m.endMs)}s`).join(", ");return{error:`op "${op}": "${phrase}" occurs ${matches.length} times in this clip -- ${list}. Pass occurrence (1-based) to pick one, or occurrence: "all" for every one.`}}let selected;if(occurrence==="all")selected=matches;else if(occurrence===void 0)selected=matches;else{let index=occurrence-1;if(index<0||index>=matches.length)return{error:`op "${op}": occurrence ${occurrence} is out of range -- "${phrase}" occurs ${matches.length} time(s) in this clip.`};selected=[matches[index]]}if(op==="replace_phrase")return replaceSelected(params.replacement,phrase,tokens.length,selected,words);let snapIndex=createWordRunSnapIndex(tracks.cap,tracks.kf),runs=selected.map(match=>{let tokenIds=words.slice(match.startIndex,match.startIndex+match.wordCount).map(word=>word.id).filter(id=>!!id);return{ranges:cutRangesForRun(tracks.cap,tracks.kf,tokenIds,snapIndex)}}),cuts=runs.flatMap(run2=>run2.ranges),guardError=assertSpansLeaveViableClip(listSectionRanges(tracks.kf),cuts,op,phrase);if(guardError)return guardError;seedOutlineBeforeEdit(tracks.script,tracks.cap);for(let cut of cuts)alignRangeToSections(tracks.cap,cut.startMs,cut.endMs);let groups=runs.map(run2=>run2.ranges.flatMap(range=>captionTokenIdsInRange(tracks.cap,range.startMs,range.endMs))).filter(run2=>run2.length>0),{captured}=groups.length?captureRemovedCaptionRange({script:tracks.script,caption:tracks.cap,keyFrame:tracks.kf,voiceEnhancement:tracks.ve,tokenIds:groups.flat(),groups}):{captured:!1},ordered=[...cuts].sort((a,b)=>b.startMs-a.startMs),affected=pairedTracks(tracks);for(let cut of ordered)for(let track of affected)deleteTimelineRange(track,cut.startMs,cut.endMs);let occurrenceLabel=selected.length>1?`all ${selected.length} occurrences`:"1 occurrence";return{op,outcome:`deleted ${occurrenceLabel} of "${phrase}"`+(captured?"; the cut transcript stays struck through and restorable in the web editor":""),changed:!0}}function isStyleOp(op){return STYLE_EDIT_OPS.includes(op)}var HEX_COLOR=/^#[0-9a-fA-F]{6}$/;var STYLE_OP_SCHEMA_PROPS={captionColor:{type:"string",description:'set_style only: the caption TEXT colour as a #RRGGBB hex string, e.g. "#FFFFFF". This is the colour of ordinary caption words.'},highlightColor:{type:"string",description:'set_style only: the KEYWORD-HIGHLIGHT colour as a #RRGGBB hex string. This is the accent colour on emphasised words (OpusClip defaults to bright green "#04f827"), not the colour of ordinary caption text -- use captionColor for that. Setting it does not switch highlighting on; add a set_keyword_highlight op to the same call to do that.'},captionPosition:{type:"string",enum:[...CAPTION_POSITIONS],description:'set_style only: which band of the frame the captions sit in -- "top", "middle" or "bottom".'},uppercase:{type:"boolean",description:"set_style only: true renders every caption word in CAPITALS."}};function parseStyleOp(op,rec){let params={};for(let field of["captionColor","highlightColor"]){if(rec[field]===void 0)continue;let value=rec[field];if(typeof value!="string"||!HEX_COLOR.test(value))return{error:`op "${op}": ${field} must be a #RRGGBB hex colour, e.g. "#FFFFFF" -- got ${JSON.stringify(value)}.`};params[field]=value}if(rec.captionPosition!==void 0){let value=rec.captionPosition;if(typeof value!="string"||!CAPTION_POSITIONS.includes(value))return{error:`op "${op}": captionPosition must be one of ${CAPTION_POSITIONS.join(", ")} -- got ${JSON.stringify(value)}.`};params.captionPosition=value}if(rec.uppercase!==void 0){if(typeof rec.uppercase!="boolean")return{error:`op "${op}": uppercase must be true or false.`};params.uppercase=rec.uppercase}return Object.keys(params).length===0?{error:`op "${op}" needs at least one of captionColor, highlightColor, captionPosition, uppercase.`}:params}function asRecord(value){return typeof value=="object"&&value!==null&&!Array.isArray(value)?value:void 0}function runStyleOp(op,params,prefPatch,currentPref){let patch={},changes=[];if(params.captionColor!==void 0){let font=asRecord(prefPatch.font)??asRecord(currentPref?.font);if(!font)return{error:`op "${op}": this clip's caption font settings could not be read, and writing the colour on its own would discard the rest of the font (family, size, stroke, shadow). Nothing was changed -- set the colour in the web editor for this clip.`};patch.font={...font,color:params.captionColor},changes.push(`caption colour -> ${params.captionColor}`)}if(params.highlightColor!==void 0){let highlight=asRecord(prefPatch.highlightColor)??asRecord(currentPref?.highlightColor);if(!highlight)return{error:`op "${op}": this clip's highlight colours could not be read, and writing one on its own would discard the secondary highlight colour. Nothing was changed -- set it in the web editor for this clip.`};patch.highlightColor={...highlight,primary:params.highlightColor},changes.push(`highlight colour -> ${params.highlightColor}`)}return params.captionPosition!==void 0&&(patch.captionPosition=params.captionPosition,changes.push(`caption position -> ${params.captionPosition}`)),params.uppercase!==void 0&&(patch.enableUppercase=params.uppercase,changes.push(`uppercase -> ${String(params.uppercase)}`)),{patch,outcome:{op,outcome:changes.join(", "),changed:!0}}}var TEXT_ONLY_PARAMS=new Set(["phrase","replacement","text"]);function splitParams(raw){let out=[],current="",quoted=!1;for(let ch of raw)ch==='"'&&(quoted=!quoted),ch===","&&!quoted?(out.push(current),current=""):current+=ch;return out.push(current),out}function unquote(value){return value.length>=2&&value.startsWith('"')&&value.endsWith('"')?value.slice(1,-1):value}function parseOpSpec(spec){let[rawOp="",rawParams=""]=splitOnce(spec,":"),op=rawOp.trim();if(!op)throw new Error("edit-clip ops: --op needs an operation name");let rec={};if(op==="reorder_sections"){let order=((rawParams.includes("=")?splitOnce(rawParams,"=")[1]:rawParams)??"").split(",").map(n=>n.trim()).filter(n=>n.length>0).map(Number);return rec.order=order,{op,rec}}for(let pair of splitParams(rawParams)){let trimmed=pair.trim();if(!trimmed)continue;let[key="",value=""]=splitOnce(trimmed,"=");if(!key.trim())continue;let name=key.trim(),trimmedValue=unquote(value.trim());if(TEXT_ONLY_PARAMS.has(name)){rec[name]=trimmedValue;continue}let num=Number(trimmedValue);trimmedValue==="true"||trimmedValue==="false"?rec[name]=trimmedValue==="true":rec[name]=trimmedValue!==""&&Number.isFinite(num)?num:trimmedValue}return{op,rec}}function splitOnce(s,sep){let i=s.indexOf(sep);return i===-1?[s,""]:[s.slice(0,i),s.slice(i+sep.length)]}function unwrap2(raw){let obj=raw??{};return obj.data??obj}function asRecord2(value){return value&&typeof value=="object"&&!Array.isArray(value)?value:void 0}var SUPPORTED_OPS=[...TIMELINE_EDIT_OPS,...PHRASE_EDIT_OPS,...STYLE_EDIT_OPS,...OVERLAY_EDIT_OPS,...EMOJI_EDIT_OPS];function needsTracks(op){return isTimelineOp(op)||isPhraseOp(op)||isOverlayOp(op)||isEmojiOp(op)}function applyTimelineOp(op,rec,instances){let params=parseTimelineOp(op,rec);if("error"in params)throw new Error(`edit-clip ops: ${params.error}`);let outcome=runTimelineOp(op,params,instances);if("error"in outcome)throw new Error(`edit-clip ops: ${outcome.error}`);return outcome.changed&&(instances.timelineChanged=!0),outcome}function applyPhraseOp(op,rec,instances){let params=parsePhraseOp(op,rec);if("error"in params)throw new Error(`edit-clip ops: ${params.error}`);let outcome=runPhraseOp(op,params,instances);if("error"in outcome)throw new Error(`edit-clip ops: ${outcome.error}`);return outcome.changed&&isCuttingPhraseOp(op)&&(instances.timelineChanged=!0),outcome}function applyOverlayOp(op,rec,instances){let params=parseOverlayOp(op,rec);if("error"in params)throw new Error(`edit-clip ops: ${params.error}`);let ranges=listSectionRanges(instances.kf),clipEndMs=ranges.length===0?0:ranges[ranges.length-1].endMs,outcome=runOverlayOp(op,params,instances.tracks,clipEndMs);if("error"in outcome)throw new Error(`edit-clip ops: ${outcome.error}`);return outcome}function applyEmojiOp(op,rec,instances){let params=parseEmojiOp(op,rec);if("error"in params)throw new Error(`edit-clip ops: ${params.error}`);let outcome=runEmojiOp(op,params,instances.tracks,instances.script);if("error"in outcome)throw new Error(`edit-clip ops: ${outcome.error}`);return outcome}function applyStyleOp(op,rec,prefPatch,currentPref){let params=parseStyleOp(op,rec);if("error"in params)throw new Error(`edit-clip ops: ${params.error}`);let result=runStyleOp(op,params,prefPatch,currentPref);if("error"in result)throw new Error(`edit-clip ops: ${result.error}`);return Object.assign(prefPatch,result.patch),result.outcome}function applyOps(parsed,instances,prefPatch,currentPref,applied){let captionTextChanged=!1;for(let{op,rec}of parsed)if(isStyleOp(op))applied.push(applyStyleOp(op,rec,prefPatch,currentPref));else if(isTimelineOp(op))applied.push(applyTimelineOp(op,rec,requireTracks(instances)));else if(isPhraseOp(op)){let outcome=applyPhraseOp(op,rec,requireTracks(instances));applied.push(outcome),outcome.changed&&!isCuttingPhraseOp(op)&&(captionTextChanged=!0)}else isOverlayOp(op)?applied.push(applyOverlayOp(op,rec,requireTracks(instances))):isEmojiOp(op)&&applied.push(applyEmojiOp(op,rec,requireTracks(instances)));return{captionTextChanged}}function describeTracks(script){let rawTracks=script.tracks;return Array.isArray(rawTracks)?rawTracks.map(t=>trackTimelineLabel(t)):[]}function requireTracks(instances){if(!instances)throw new Error("edit-clip ops: this clip has no editable track pair.");return instances}function tidyAndSerialize(instances,applied){let tidy=tidyOverlayTracksAfterTimelineOps(instances.tracks,instances.kf);if("error"in tidy)throw new Error(`edit-clip ops: ${tidy.error}`);if(tidy.dropped.length>0&&applied.length>0){let summary=tidy.dropped.map(d=>`${d.count} ${d.trackType}`).join(", ");applied[applied.length-1].outcome+=`; dropped stale overlay sections (${summary})`}serializeTimelineTracks(instances)}function validateArgs(args){let projectId=args.projectId?.trim(),clipId=args.clipId?.trim();if(!projectId)throw new Error("edit-clip ops: --project is required");if(!clipId)throw new Error("edit-clip ops: --clip is required");let specs=args.ops??[];if(specs.length===0&&!args.dryRun)throw new Error(`edit-clip ops: at least one --op is required (${SUPPORTED_OPS.join(", ")})`);let parsed=specs.map(spec=>parseOpSpec(spec));for(let{op}of parsed)if(!needsTracks(op)&&!isStyleOp(op))throw new Error(`edit-clip ops: unknown op '${op}'. Supported: ${SUPPORTED_OPS.join(", ")}.`);return{projectId,clipId,parsed}}async function runEditOps(api,args){let{projectId,clipId,parsed}=validateArgs(args),cid=clipSuffix(clipId,projectId),raw=await api.get(`/exportable-clips/${projectId}.${cid}?include=editingScript`),script=unwrap2(raw).editingScript;if(!script||typeof script!=